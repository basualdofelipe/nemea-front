NEXT_PUBLIC_APP_NAME=Hefesto
NEXT_PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development

# NextAuth (Auth.js v5)
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Demo login — shows the "Entrar como demo" button on the login page (clone -> start).
# Pairs with DEMO_LOGIN_ENABLED=true on the backend.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=true
NEXT_PUBLIC_DEMO_EMAIL=demo@hefesto.com
NEXT_PUBLIC_CONTACT_EMAIL=admin@hefesto.com
